{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Q Calc",
  "version": "../package.json",
  "identifier": "com.maxconine.qcalc",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5311",
    "beforeDevCommand": "npx vite --port 5311 --strictPort",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [],
    "macOSPrivateApi": true,
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.ico", "icons/icon.icns"]
  }
}
