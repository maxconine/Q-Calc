{
  "name": "qcalc",
  "private": true,
  "version": "2.0.2",
  "description": "Q Calc — a Spotlight-style scientific calculator for Mac",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maxconine/Q-Calc.git"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:scientific": "vitest run src/engine/scientific.test.ts",
    "test:units": "vitest run src/engine/units.test.ts",
    "lint": "oxlint",
    "preview": "vite preview",
    "mac": "zsh macos/build.sh",
    "mac:install": "zsh macos/build.sh --install",
    "mac:package": "zsh macos/build.sh --package",
    "win:dev": "tauri dev",
    "win:build": "tauri build"
  },
  "dependencies": {
    "@myriaddreamin/typst-ts-renderer": "^0.7.0",
    "@myriaddreamin/typst-ts-web-compiler": "^0.7.0",
    "@myriaddreamin/typst.ts": "^0.7.0",
    "decimal.js": "^10.6.0",
    "mathjs": "^15.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^3.2.7"
  }
}
