[
 {
  "id": "identities",
  "title": "Identities",
  "hint": "identity sheet",
  "sections": [
   {
    "title": "Trig",
    "groups": [
     {
      "title": "Pythagorean",
      "items": [
       {
        "show": "sin^{2}x + cos^{2}x = 1",
        "copy": "sin(x)^2 + cos(x)^2 = 1"
       },
       {
        "show": "1 + tan^{2}x = sec^{2}x",
        "copy": "1 + tan(x)^2 = sec(x)^2"
       },
       {
        "show": "1 + cot^{2}x = csc^{2}x",
        "copy": "1 + cot(x)^2 = csc(x)^2"
       }
      ]
     },
     {
      "title": "Reciprocal",
      "items": [
       {
        "show": "csc x = 1/sin x",
        "copy": "csc(x) = 1/sin(x)"
       },
       {
        "show": "sec x = 1/cos x",
        "copy": "sec(x) = 1/cos(x)"
       },
       {
        "show": "cot x = 1/tan x",
        "copy": "cot(x) = 1/tan(x)"
       }
      ]
     },
     {
      "title": "Quotient",
      "items": [
       {
        "show": "tan x = sin x / cos x",
        "copy": "tan(x) = sin(x)/cos(x)"
       },
       {
        "show": "cot x = cos x / sin x",
        "copy": "cot(x) = cos(x)/sin(x)"
       }
      ]
     },
     {
      "title": "Cofunction",
      "items": [
       {
        "show": "sin(π/2 − x) = cos x",
        "copy": "sin(pi/2 - x) = cos(x)"
       },
       {
        "show": "cos(π/2 − x) = sin x",
        "copy": "cos(pi/2 - x) = sin(x)"
       },
       {
        "show": "tan(π/2 − x) = cot x",
        "copy": "tan(pi/2 - x) = cot(x)"
       },
       {
        "show": "cot(π/2 − x) = tan x",
        "copy": "cot(pi/2 - x) = tan(x)"
       },
       {
        "show": "sec(π/2 − x) = csc x",
        "copy": "sec(pi/2 - x) = csc(x)"
       },
       {
        "show": "csc(π/2 − x) = sec x",
        "copy": "csc(pi/2 - x) = sec(x)"
       }
      ]
     },
     {
      "title": "Even and odd",
      "items": [
       {
        "show": "sin(−x) = −sin x",
        "copy": "sin(-x) = -sin(x)"
       },
       {
        "show": "cos(−x) = cos x",
        "copy": "cos(-x) = cos(x)"
       },
       {
        "show": "tan(−x) = −tan x",
        "copy": "tan(-x) = -tan(x)"
       }
      ]
     },
     {
      "title": "Sum and difference",
      "items": [
       {
        "show": "sin(x + y) = sin x cos y + cos x sin y",
        "copy": "sin(x + y) = sin(x)cos(y) + cos(x)sin(y)"
       },
       {
        "show": "sin(x − y) = sin x cos y − cos x sin y",
        "copy": "sin(x - y) = sin(x)cos(y) - cos(x)sin(y)"
       },
       {
        "show": "cos(x + y) = cos x cos y − sin x sin y",
        "copy": "cos(x + y) = cos(x)cos(y) - sin(x)sin(y)"
       },
       {
        "show": "cos(x − y) = cos x cos y + sin x sin y",
        "copy": "cos(x - y) = cos(x)cos(y) + sin(x)sin(y)"
       },
       {
        "show": "tan(x + y) = (tan x + tan y)/(1 − tan x tan y)",
        "copy": "tan(x + y) = (tan(x) + tan(y))/(1 - tan(x)tan(y))"
       },
       {
        "show": "tan(x − y) = (tan x − tan y)/(1 + tan x tan y)",
        "copy": "tan(x - y) = (tan(x) - tan(y))/(1 + tan(x)tan(y))"
       }
      ]
     },
     {
      "title": "Double angle",
      "items": [
       {
        "show": "sin 2x = 2 sin x cos x",
        "copy": "sin(2x) = 2sin(x)cos(x)"
       },
       {
        "show": "cos 2x = cos^{2}x − sin^{2}x",
        "copy": "cos(2x) = cos(x)^2 - sin(x)^2"
       },
       {
        "show": "cos 2x = 2cos^{2}x − 1",
        "copy": "cos(2x) = 2cos(x)^2 - 1"
       },
       {
        "show": "cos 2x = 1 − 2sin^{2}x",
        "copy": "cos(2x) = 1 - 2sin(x)^2"
       },
       {
        "show": "tan 2x = 2 tan x/(1 − tan^{2}x)",
        "copy": "tan(2x) = 2tan(x)/(1 - tan(x)^2)"
       }
      ]
     },
     {
      "title": "Half angle",
      "items": [
       {
        "show": "sin(x/2) = ±√((1 − cos x)/2)",
        "copy": "sin(x/2) = ±sqrt((1 - cos(x))/2)"
       },
       {
        "show": "cos(x/2) = ±√((1 + cos x)/2)",
        "copy": "cos(x/2) = ±sqrt((1 + cos(x))/2)"
       },
       {
        "show": "tan(x/2) = (1 − cos x)/sin x",
        "copy": "tan(x/2) = (1 - cos(x))/sin(x)"
       },
       {
        "show": "tan(x/2) = sin x/(1 + cos x)",
        "copy": "tan(x/2) = sin(x)/(1 + cos(x))"
       }
      ]
     },
     {
      "title": "Power reduction",
      "items": [
       {
        "show": "sin^{2}x = (1 − cos 2x)/2",
        "copy": "sin(x)^2 = (1 - cos(2x))/2"
       },
       {
        "show": "cos^{2}x = (1 + cos 2x)/2",
        "copy": "cos(x)^2 = (1 + cos(2x))/2"
       },
       {
        "show": "tan^{2}x = (1 − cos 2x)/(1 + cos 2x)",
        "copy": "tan(x)^2 = (1 - cos(2x))/(1 + cos(2x))"
       }
      ]
     },
     {
      "title": "Product to sum",
      "items": [
       {
        "show": "sin x sin y = ½[cos(x − y) − cos(x + y)]",
        "copy": "sin(x)sin(y) = (cos(x - y) - cos(x + y))/2"
       },
       {
        "show": "cos x cos y = ½[cos(x − y) + cos(x + y)]",
        "copy": "cos(x)cos(y) = (cos(x - y) + cos(x + y))/2"
       },
       {
        "show": "sin x cos y = ½[sin(x + y) + sin(x − y)]",
        "copy": "sin(x)cos(y) = (sin(x + y) + sin(x - y))/2"
       },
       {
        "show": "cos x sin y = ½[sin(x + y) − sin(x − y)]",
        "copy": "cos(x)sin(y) = (sin(x + y) - sin(x - y))/2"
       }
      ]
     },
     {
      "title": "Sum to product",
      "items": [
       {
        "show": "sin x + sin y = 2 sin((x + y)/2) cos((x − y)/2)",
        "copy": "sin(x) + sin(y) = 2sin((x + y)/2)cos((x - y)/2)"
       },
       {
        "show": "sin x − sin y = 2 cos((x + y)/2) sin((x − y)/2)",
        "copy": "sin(x) - sin(y) = 2cos((x + y)/2)sin((x - y)/2)"
       },
       {
        "show": "cos x + cos y = 2 cos((x + y)/2) cos((x − y)/2)",
        "copy": "cos(x) + cos(y) = 2cos((x + y)/2)cos((x - y)/2)"
       },
       {
        "show": "cos x − cos y = −2 sin((x + y)/2) sin((x − y)/2)",
        "copy": "cos(x) - cos(y) = -2sin((x + y)/2)sin((x - y)/2)"
       }
      ]
     }
    ]
   },
   {
    "title": "Logs and exponents",
    "groups": [
     {
      "title": "Log rules",
      "items": [
       {
        "show": "log_{b}(xy) = log_{b}x + log_{b}y",
        "copy": "log(x y, b) = log(x, b) + log(y, b)"
       },
       {
        "show": "log_{b}(x/y) = log_{b}x − log_{b}y",
        "copy": "log(x/y, b) = log(x, b) - log(y, b)"
       },
       {
        "show": "log_{b}(x^{r}) = r log_{b}x",
        "copy": "log(x^r, b) = r log(x, b)"
       },
       {
        "show": "log_{b}x = ln x / ln b",
        "copy": "log(x, b) = ln(x)/ln(b)",
        "note": "change of base"
       },
       {
        "show": "log_{b}1 = 0",
        "copy": "log(1, b) = 0"
       },
       {
        "show": "log_{b}b = 1",
        "copy": "log(b, b) = 1"
       }
      ]
     },
     {
      "title": "Inverses",
      "items": [
       {
        "show": "log_{b}(b^{x}) = x",
        "copy": "log(b^x, b) = x"
       },
       {
        "show": "b^{log_{b}x} = x",
        "copy": "b^log(x, b) = x"
       },
       {
        "show": "ln(e^{x}) = x",
        "copy": "ln(e^x) = x"
       },
       {
        "show": "e^{ln x} = x",
        "copy": "e^ln(x) = x"
       }
      ]
     },
     {
      "title": "Exponent rules",
      "items": [
       {
        "show": "a^{m}a^{n} = a^{m+n}",
        "copy": "a^m a^n = a^(m + n)"
       },
       {
        "show": "a^{m}/a^{n} = a^{m−n}",
        "copy": "a^m/a^n = a^(m - n)"
       },
       {
        "show": "(a^{m})^{n} = a^{mn}",
        "copy": "(a^m)^n = a^(m n)"
       },
       {
        "show": "(ab)^{n} = a^{n}b^{n}",
        "copy": "(a b)^n = a^n b^n"
       },
       {
        "show": "(a/b)^{n} = a^{n}/b^{n}",
        "copy": "(a/b)^n = a^n/b^n"
       },
       {
        "show": "a^{0} = 1",
        "copy": "a^0 = 1"
       },
       {
        "show": "a^{−n} = 1/a^{n}",
        "copy": "a^(-n) = 1/a^n"
       },
       {
        "show": "a^{1/n} = ^{n}√a",
        "copy": "a^(1/n) = nthroot(a, n)"
       }
      ]
     }
    ]
   },
   {
    "title": "Algebra",
    "groups": [
     {
      "title": "Squares",
      "items": [
       {
        "show": "(a + b)^{2} = a^{2} + 2ab + b^{2}",
        "copy": "(a + b)^2 = a^2 + 2a b + b^2"
       },
       {
        "show": "(a − b)^{2} = a^{2} − 2ab + b^{2}",
        "copy": "(a - b)^2 = a^2 - 2a b + b^2"
       },
       {
        "show": "a^{2} − b^{2} = (a + b)(a − b)",
        "copy": "a^2 - b^2 = (a + b)(a - b)"
       }
      ]
     },
     {
      "title": "Cubes",
      "items": [
       {
        "show": "a^{3} + b^{3} = (a + b)(a^{2} − ab + b^{2})",
        "copy": "a^3 + b^3 = (a + b)(a^2 - a b + b^2)"
       },
       {
        "show": "a^{3} − b^{3} = (a − b)(a^{2} + ab + b^{2})",
        "copy": "a^3 - b^3 = (a - b)(a^2 + a b + b^2)"
       },
       {
        "show": "(a + b)^{3} = a^{3} + 3a^{2}b + 3ab^{2} + b^{3}",
        "copy": "(a + b)^3 = a^3 + 3a^2 b + 3a b^2 + b^3"
       },
       {
        "show": "(a − b)^{3} = a^{3} − 3a^{2}b + 3ab^{2} − b^{3}",
        "copy": "(a - b)^3 = a^3 - 3a^2 b + 3a b^2 - b^3"
       }
      ]
     },
     {
      "title": "Binomial theorem",
      "items": [
       {
        "show": "(a + b)^{n} = Σ_{k=0}^{n} C(n, k) a^{n−k}b^{k}",
        "copy": "(a + b)^n = Σ nCr(n, k) a^(n - k) b^k, k = 0..n"
       }
      ]
     }
    ]
   },
   {
    "title": "Partial fractions",
    "wide": true,
    "groups": [
     {
      "title": "Distinct linear factors",
      "items": [
       {
        "show": "(px + q)/((x − a)(x − b)) = A/(x − a) + B/(x − b)",
        "copy": "(p x + q)/((x - a)(x - b)) = A/(x - a) + B/(x - b)"
       },
       {
        "show": "A = (pa + q)/(a − b)",
        "copy": "A = (p a + q)/(a - b)"
       },
       {
        "show": "B = (pb + q)/(b − a)",
        "copy": "B = (p b + q)/(b - a)"
       },
       {
        "show": "1/(x^{2} − a^{2}) = (1/(x − a) − 1/(x + a))/2a",
        "copy": "1/(x^2 - a^2) = (1/(x - a) - 1/(x + a))/(2a)"
       }
      ]
     },
     {
      "title": "Repeated linear factor",
      "items": [
       {
        "show": "(px + q)/(x − a)^{2} = A/(x − a) + B/(x − a)^{2}",
        "copy": "(p x + q)/(x - a)^2 = A/(x - a) + B/(x - a)^2"
       },
       {
        "show": "A = p",
        "copy": "A = p"
       },
       {
        "show": "B = pa + q",
        "copy": "B = p a + q"
       }
      ]
     },
     {
      "title": "Irreducible quadratic factor",
      "items": [
       {
        "show": "(px + q)/((x − a)(x^{2} + b^{2})) = A/(x − a) + (Bx + C)/(x^{2} + b^{2})",
        "copy": "(p x + q)/((x - a)(x^2 + b^2)) = A/(x - a) + (B x + C)/(x^2 + b^2)"
       },
       {
        "show": "A = (pa + q)/(a^{2} + b^{2})",
        "copy": "A = (p a + q)/(a^2 + b^2)"
       },
       {
        "show": "B = −A",
        "copy": "B = -A"
       },
       {
        "show": "C = p − aA",
        "copy": "C = p - a A"
       }
      ]
     }
    ]
   },
   {
    "title": "Summation",
    "groups": [
     {
      "title": "Powers",
      "items": [
       {
        "show": "Σ_{k=1}^{n} 1 = n",
        "copy": "Σ 1, k = 1..n = n"
       },
       {
        "show": "Σ_{k=1}^{n} k = n(n + 1)/2",
        "copy": "Σ k, k = 1..n = n(n + 1)/2"
       },
       {
        "show": "Σ_{k=1}^{n} k^{2} = n(n + 1)(2n + 1)/6",
        "copy": "Σ k^2, k = 1..n = n(n + 1)(2n + 1)/6"
       },
       {
        "show": "Σ_{k=1}^{n} k^{3} = (n(n + 1)/2)^{2}",
        "copy": "Σ k^3, k = 1..n = (n(n + 1)/2)^2"
       },
       {
        "show": "Σ_{k=1}^{n} (2k − 1) = n^{2}",
        "copy": "Σ (2k - 1), k = 1..n = n^2",
        "note": "odd numbers"
       }
      ]
     },
     {
      "title": "Arithmetic and geometric",
      "items": [
       {
        "show": "Σ_{k=1}^{n} (a + (k − 1)d) = n(2a + (n − 1)d)/2",
        "copy": "Σ (a + (k - 1)d), k = 1..n = n(2a + (n - 1)d)/2"
       },
       {
        "show": "Σ_{k=1}^{n} ar^{k−1} = a(1 − r^{n})/(1 − r)",
        "copy": "Σ a r^(k - 1), k = 1..n = a(1 - r^n)/(1 - r)",
        "note": "r ≠ 1"
       },
       {
        "show": "Σ_{k=0}^{∞} ar^{k} = a/(1 − r)",
        "copy": "Σ a r^k, k = 0..∞ = a/(1 - r)",
        "note": "|r| < 1"
       },
       {
        "show": "Σ_{k=1}^{∞} kr^{k} = r/(1 − r)^{2}",
        "copy": "Σ k r^k, k = 1..∞ = r/(1 - r)^2",
        "note": "|r| < 1"
       }
      ]
     },
     {
      "title": "Series",
      "items": [
       {
        "show": "Σ_{k=0}^{∞} x^{k}/k! = e^{x}",
        "copy": "Σ x^k/k!, k = 0..∞ = e^x"
       },
       {
        "show": "Σ_{k=0}^{n} C(n, k) = 2^{n}",
        "copy": "Σ nCr(n, k), k = 0..n = 2^n"
       }
      ]
     }
    ]
   }
  ]
 },
 {
  "id": "calculus",
  "title": "Derivatives and Integrals",
  "hint": "derivatives and integrals",
  "sections": [
   {
    "title": "Derivatives",
    "groups": [
     {
      "title": "Powers, exponentials and logs",
      "items": [
       {
        "show": "d/dx x^{n} = nx^{n−1}",
        "copy": "d/dx x^n = n x^(n - 1)"
       },
       {
        "show": "d/dx e^{x} = e^{x}",
        "copy": "d/dx e^x = e^x"
       },
       {
        "show": "d/dx b^{x} = b^{x} ln b",
        "copy": "d/dx b^x = b^x ln(b)"
       },
       {
        "show": "d/dx ln x = 1/x",
        "copy": "d/dx ln(x) = 1/x"
       },
       {
        "show": "d/dx log_{b}x = 1/(x ln b)",
        "copy": "d/dx log(x, b) = 1/(x ln(b))"
       }
      ]
     },
     {
      "title": "Trig",
      "items": [
       {
        "show": "d/dx sin x = cos x",
        "copy": "d/dx sin(x) = cos(x)"
       },
       {
        "show": "d/dx cos x = −sin x",
        "copy": "d/dx cos(x) = -sin(x)"
       },
       {
        "show": "d/dx tan x = sec^{2}x",
        "copy": "d/dx tan(x) = sec(x)^2"
       },
       {
        "show": "d/dx cot x = −csc^{2}x",
        "copy": "d/dx cot(x) = -csc(x)^2"
       },
       {
        "show": "d/dx sec x = sec x tan x",
        "copy": "d/dx sec(x) = sec(x)tan(x)"
       },
       {
        "show": "d/dx csc x = −csc x cot x",
        "copy": "d/dx csc(x) = -csc(x)cot(x)"
       }
      ]
     },
     {
      "title": "Inverse trig",
      "items": [
       {
        "show": "d/dx arcsin x = 1/√(1 − x^{2})",
        "copy": "d/dx arcsin(x) = 1/sqrt(1 - x^2)"
       },
       {
        "show": "d/dx arccos x = −1/√(1 − x^{2})",
        "copy": "d/dx arccos(x) = -1/sqrt(1 - x^2)"
       },
       {
        "show": "d/dx arctan x = 1/(1 + x^{2})",
        "copy": "d/dx arctan(x) = 1/(1 + x^2)"
       }
      ]
     },
     {
      "title": "Rules",
      "items": [
       {
        "show": "(fg)′ = f′g + fg′",
        "copy": "d/dx f(x)g(x) = f'(x)g(x) + f(x)g'(x)",
        "note": "product"
       },
       {
        "show": "(f/g)′ = (f′g − fg′)/g^{2}",
        "copy": "d/dx f(x)/g(x) = (f'(x)g(x) - f(x)g'(x))/g(x)^2",
        "note": "quotient"
       },
       {
        "show": "f(g(x))′ = f′(g(x)) g′(x)",
        "copy": "d/dx f(g(x)) = f'(g(x))g'(x)",
        "note": "chain"
       }
      ]
     }
    ]
   },
   {
    "title": "Integrals",
    "groups": [
     {
      "title": "Powers, exponentials and logs",
      "items": [
       {
        "show": "∫ x^{n} dx = x^{n+1}/(n + 1) + C",
        "copy": "∫ x^n dx = x^(n + 1)/(n + 1) + C",
        "note": "n ≠ −1"
       },
       {
        "show": "∫ 1/x dx = ln|x| + C",
        "copy": "∫ 1/x dx = ln(abs(x)) + C"
       },
       {
        "show": "∫ e^{x} dx = e^{x} + C",
        "copy": "∫ e^x dx = e^x + C"
       },
       {
        "show": "∫ b^{x} dx = b^{x}/ln b + C",
        "copy": "∫ b^x dx = b^x/ln(b) + C"
       }
      ]
     },
     {
      "title": "Trig",
      "items": [
       {
        "show": "∫ sin x dx = −cos x + C",
        "copy": "∫ sin(x) dx = -cos(x) + C"
       },
       {
        "show": "∫ cos x dx = sin x + C",
        "copy": "∫ cos(x) dx = sin(x) + C"
       },
       {
        "show": "∫ sec^{2}x dx = tan x + C",
        "copy": "∫ sec(x)^2 dx = tan(x) + C"
       },
       {
        "show": "∫ csc^{2}x dx = −cot x + C",
        "copy": "∫ csc(x)^2 dx = -cot(x) + C"
       },
       {
        "show": "∫ sec x tan x dx = sec x + C",
        "copy": "∫ sec(x)tan(x) dx = sec(x) + C"
       },
       {
        "show": "∫ csc x cot x dx = −csc x + C",
        "copy": "∫ csc(x)cot(x) dx = -csc(x) + C"
       },
       {
        "show": "∫ tan x dx = ln|sec x| + C",
        "copy": "∫ tan(x) dx = ln(abs(sec(x))) + C"
       },
       {
        "show": "∫ cot x dx = ln|sin x| + C",
        "copy": "∫ cot(x) dx = ln(abs(sin(x))) + C"
       },
       {
        "show": "∫ sec x dx = ln|sec x + tan x| + C",
        "copy": "∫ sec(x) dx = ln(abs(sec(x) + tan(x))) + C"
       },
       {
        "show": "∫ csc x dx = −ln|csc x + cot x| + C",
        "copy": "∫ csc(x) dx = -ln(abs(csc(x) + cot(x))) + C"
       },
       {
        "show": "∫ sin^{2}x dx = x/2 − sin 2x/4 + C",
        "copy": "∫ sin(x)^2 dx = x/2 - sin(2x)/4 + C"
       },
       {
